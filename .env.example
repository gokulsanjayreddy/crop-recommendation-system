# Database connection URL
# Default SQLite for local development:
DATABASE_URL=sqlite:///backend/app.db
# For PostgreSQL (future migration chunks):
# DATABASE_URL=postgresql://user:password@localhost:5432/crop_db

# Directory paths
MODEL_DIR=models
DATA_DIR=data

# External API & HTTP timeouts (seconds)
HTTP_TIMEOUT=10.0
OPEN_METEO_TIMEOUT=10.0
NASA_POWER_TIMEOUT=30.0
SOILGRIDS_TIMEOUT=15.0
