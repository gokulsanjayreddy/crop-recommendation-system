# Database connection URL
# Default PostgreSQL (for docker-compose postgres:16 service):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crop_db
# SQLite fallback (used for tests or lightweight local standalone):
# DATABASE_URL=sqlite:///backend/app.db

# Directory paths
MODEL_DIR=models
DATA_DIR=data

# External API & HTTP timeouts (seconds)
HTTP_TIMEOUT=10.0
OPEN_METEO_TIMEOUT=10.0
NASA_POWER_TIMEOUT=30.0
SOILGRIDS_TIMEOUT=15.0
